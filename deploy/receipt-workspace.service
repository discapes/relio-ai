[Unit]
Description=Relio RELEX project memory
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/user/aaltoai/challenges/relex/solution_3
ExecStart=/usr/bin/env node --env-file-if-exists=.env scripts/start.mjs
Environment=NODE_ENV=production
Environment=APP_BUILD_DIR=.releases/current
Environment=HOST=127.0.0.1
Environment=PORT=34342
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
